{
  // OpenCode configuration for kiswap — Next.js on Cloudflare
  // Docs: https://developers.cloudflare.com/agent-setup/opencode/
  "mcp": {
    // Full Cloudflare API via Code Mode (~1,000 tokens, 2,500+ endpoints)
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    // Up-to-date Cloudflare documentation
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    // Workers bindings: KV, D1, R2, AI, Queues, etc.
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    // Workers Builds — insights & build management
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    // Observability — logs, analytics, debugging
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true
    }
  }
}
